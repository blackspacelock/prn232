erDiagram
    JobTrend {
        UUID JobTrendId PK
        NVARCHAR255 TechSkill
        NVARCHARMAX Description
        NVARCHAR255 Source
        NVARCHAR255 Region
        INT TrendScore
        DATETIME SnapshotDate
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    User {
        UUID UserId PK
        NVARCHAR255 FullName
        NVARCHAR255 Email
        NVARCHARMAX PasswordHashed
        INT Role
        BIT IsActive
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Profile {
        UUID UserId PK
        NVARCHARMAX BioDescription
        NVARCHARMAX PhoneNumber
        NVARCHAR255 University
        NVARCHAR255 Major
        INT StudiedYear
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Skill {
        UUID SkillId PK
        UUID ProfileId FK
        NVARCHAR255 SkillName
        NVARCHARMAX Note
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    GitHubRepository {
        UUID GithubRepositoryId PK
        UUID ProfileId FK
        NVARCHAR255 RepositoryName
        NVARCHARMAX RepoUrl
        NVARCHARMAX Description
        BIT IsPrivate
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    ChatSession {
        UUID ChatSessionId PK
        UUID ProfileId FK
        NVARCHAR255 Title
        NVARCHARMAX Summary
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    ChatMessage {
        UUID ChatMessageId PK
        UUID ChatSessionId FK
        NVARCHAR100 Sender
        NVARCHARMAX MessageContent
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    PersonalRoadmap {
        UUID PersonalRoadmapId PK
        UUID ProfileId FK
        UUID CareerRoadmapId FK
        NVARCHARMAX Note
        DECIMAL ProgressPercentage
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    NodeProgress {
        UUID NodeProgressId PK
        UUID PersonalRoadmapId FK
        UUID NodeId FK
        INT Status
        NVARCHARMAX Note
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    CareerRole {
        UUID CareerRoleId PK
        NVARCHAR255 Name
        NVARCHARMAX Description
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    CareerRoadmap {
        UUID CareerRoadmapId PK
        UUID CareerRoleId FK
        NVARCHAR255 Name
        NVARCHARMAX Description
        BIT IsCustom
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    RoadmapNode {
        UUID RoadmapNodeId PK
        UUID CareerRoadmapId FK
        UUID NodeId FK
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Node {
        UUID NodeId PK
        UUID ParentNodeId FK
        NVARCHAR255 Name
        NVARCHARMAX Description
        INT Order
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    LearningResource {
        UUID LearningResourceId PK
        UUID NodeId FK
        NVARCHAR255 Name
        NVARCHARMAX ResourceUrl
        NVARCHAR100 ResourceType
        NVARCHAR255 Provider
        BIT IsFree
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    %% ── User & Profile ──────────────────────────────
    %% One User has exactly one Profile
    User ||--|| Profile : "has"

    %% ── Profile → Skills ────────────────────────────
    %% One Profile has zero or many Skills
    Profile ||--o{ Skill : "has"

    %% ── Profile → GitHub Repositories ───────────────
    %% One Profile has one or many GitHubRepositories
    Profile ||--|{ GitHubRepository : "has"

    %% ── Profile → Chat ──────────────────────────────
    %% One Profile has zero or many ChatSessions
    Profile ||--o{ ChatSession : "has"
    %% One ChatSession has one or many ChatMessages
    ChatSession ||--|{ ChatMessage : "has"

    %% ── Profile → Personal Roadmaps ─────────────────
    %% One Profile has zero or many PersonalRoadmaps
    Profile ||--o{ PersonalRoadmap : "has"

    %% ── Career structure ────────────────────────────
    %% One CareerRole has one or many CareerRoadmaps
    CareerRole ||--|{ CareerRoadmap : "defines"

    %% Many PersonalRoadmaps reference one CareerRoadmap
    %% (many Profiles → many CareerRoadmaps via PersonalRoadmap)
    CareerRoadmap ||--o{ PersonalRoadmap : "referenced by"

    %% ── CareerRoadmap ↔ Node (via RoadmapNode) ──────
    %% One CareerRoadmap has zero or many RoadmapNodes
    CareerRoadmap ||--o{ RoadmapNode : "contains"
    %% One Node appears in one or many RoadmapNodes
    Node ||--|{ RoadmapNode : "referenced by"

    %% ── PersonalRoadmap ↔ Node (via NodeProgress) ───
    %% One PersonalRoadmap has zero or many NodeProgress entries
    PersonalRoadmap ||--o{ NodeProgress : "tracks"
    %% Many NodeProgress entries reference one Node
    NodeProgress }o--|| Node : "for"

    %% ── Node → Learning Resources (1:M) ─────────────
    %% One Node has zero or many LearningResources directly
    Node ||--o{ LearningResource : "has"

    %% ── Node self-reference (hierarchy) ─────────────
    Node ||--o{ Node : "parent of"