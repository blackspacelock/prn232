erDiagram
    JobTrend {
        UUID JobTrendId PK
        NVARCHAR(255) TechSkill
        NVARCHAR(MAX) Description
        NVARCHAR(255) Source
        NVARCHAR(255) Region
        INT TrendScore
        DATETIME SnapshotDate
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    User {
        UUID UserId PK
        NVARCHAR(255) FullName
        NVARCHAR(255) Email "UNIQUE"
        NVARCHAR(MAX) PasswordHashed "NULLABLE"
        INT Role
        BIT IsActive
        NVARCHAR(255) GoogleId "UNIQUE, NULLABLE"
        NVARCHAR(MAX) AvatarUrl "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Profile {
        UUID UserId PK, FK
        NVARCHAR(MAX) BioDescription "NULLABLE"
        NVARCHAR(MAX) PhoneNumber "NULLABLE"
        NVARCHAR(255) University "NULLABLE"
        NVARCHAR(255) Major "NULLABLE"
        INT StudiedYear "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Skill {
        UUID SkillId PK
        UUID ProfileId FK
        NVARCHAR(255) SkillName
        NVARCHAR(MAX) Note "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    GitHubRepository {
        UUID GithubRepositoryId PK
        UUID ProfileId FK
        NVARCHAR(255) RepositoryName
        NVARCHAR(MAX) RepoUrl
        NVARCHAR(MAX) Description "NULLABLE"
        BIT IsPrivate
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    ChatSession {
        UUID ChatSessionId PK
        UUID ProfileId FK
        NVARCHAR(255) Title
        NVARCHAR(MAX) Summary "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    ChatMessage {
        UUID ChatMessageId PK
        UUID ChatSessionId FK
        NVARCHAR(100) Sender
        NVARCHAR(MAX) MessageContent
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    CareerRole {
        UUID CareerRoleId PK
        NVARCHAR(255) Name
        NVARCHAR(MAX) Description "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    CareerRoadmap {
        UUID CareerRoadmapId PK
        UUID CareerRoleId FK
        NVARCHAR(255) Name
        NVARCHAR(MAX) Description "NULLABLE"
        BIT IsCustom
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    PersonalRoadmap {
        UUID PersonalRoadmapId PK
        UUID ProfileId FK
        UUID CareerRoadmapId FK
        NVARCHAR(MAX) Note "NULLABLE"
        DECIMAL(5_2) ProgressPercentage
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    Node {
        UUID NodeId PK
        UUID ParentNodeId FK "NULLABLE"
        NVARCHAR(255) Name
        NVARCHAR(MAX) Description "NULLABLE"
        INT Order
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    RoadmapNode {
        UUID RoadmapNodeId PK
        UUID CareerRoadmapId FK
        UUID NodeId FK
        UUID ParentRoadmapNodeId FK "NULLABLE"
        INT Order
        NVARCHAR(100) NodeType
        NVARCHAR(100) RequirementType
        INT PositionX "NULLABLE"
        INT PositionY "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    RoadmapNodeEdge {
        UUID RoadmapNodeEdgeId PK
        UUID CareerRoadmapId FK
        UUID FromRoadmapNodeId FK
        UUID ToRoadmapNodeId FK
        NVARCHAR(100) EdgeType
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    NodeProgress {
        UUID NodeProgressId PK
        UUID PersonalRoadmapId FK
        UUID RoadmapNodeId FK
        INT Status
        NVARCHAR(MAX) Note "NULLABLE"
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    LearningResource {
        UUID LearningResourceId PK
        UUID NodeId FK
        NVARCHAR(255) Name
        NVARCHAR(MAX) ResourceUrl
        NVARCHAR(100) ResourceType
        NVARCHAR(255) Provider "NULLABLE"
        BIT IsFree
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    UserRefreshToken {
        UUID UserRefreshTokenId PK
        UUID UserId FK
        NVARCHAR(512) Token
        DATETIME ExpiresAt
        DATETIME RevokedAt
        DATETIME CreatedAt
        DATETIME UpdatedAt
        BIT IsDeleted
    }

    %% Physical Relationships
    User ||--|| Profile : "UserId (1:1 Shared PK)"
    Profile ||--o{ Skill : "ProfileId"
    Profile ||--o{ GitHubRepository : "ProfileId"
    Profile ||--o{ ChatSession : "ProfileId"
    ChatSession ||--o{ ChatMessage : "ChatSessionId"
    User ||--o{ UserRefreshToken : "UserId"
    
    CareerRole ||--o{ CareerRoadmap : "CareerRoleId"
    Profile ||--o{ PersonalRoadmap : "ProfileId"
    CareerRoadmap ||--o{ PersonalRoadmap : "CareerRoadmapId"
    
    CareerRoadmap ||--o{ RoadmapNode : "CareerRoadmapId"
    Node ||--o{ RoadmapNode : "NodeId"
    RoadmapNode |o--o{ RoadmapNode : "ParentRoadmapNodeId"
    CareerRoadmap ||--o{ RoadmapNodeEdge : "CareerRoadmapId"
    RoadmapNode ||--o{ RoadmapNodeEdge : "FromRoadmapNodeId"
    RoadmapNode ||--o{ RoadmapNodeEdge : "ToRoadmapNodeId"
    
    PersonalRoadmap ||--o{ NodeProgress : "PersonalRoadmapId"
    RoadmapNode ||--o{ NodeProgress : "RoadmapNodeId"
    
    Node ||--o{ LearningResource : "NodeId (1:M direct)"
    Node |o--o{ Node : "ParentNodeId"
